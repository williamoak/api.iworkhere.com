# Example environment variables for local development and tests
# DO NOT commit secret values in real projects. This is an example only.

HOST_IP=127.0.0.1
APP_KEY=api.example.com
NODE_ENV=development
API_VERSION=v1

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

MAX_CONCURRENT_REQUESTS=100

SEED_BILL_PASSWORD=your_secure_seed_password_here
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RESET_TOKEN_TTL_SECONDS=3600

DEBUG=false
AUTH_ME_DEBUG=false
AUTH_MW_DEBUG=0
AUTH_OA_DEBUG=false

# === CockroachDB ===
DB_HOST=localhost
DB_HOSTNAME=api.example.com
DB_PORT=26257
DB_NAME=api
DB_USER=api
DB_CERT_DIR=/path/to/certs/cockroach

# === API Server Certificates ===
API_CERT_DIR=/path/to/certs/api

# === Root CA for mTLS (used by API server for client cert verification) ===
ROOT_CA_CERT=/path/to/certs/ca/ca.crt

# === OAuth2 (Note: all URLs must use https) ===
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/v1/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_STATE_SECRET=your-oauth-state-secret-string

GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=https://api.example.com/auth/oauth/success
GOOGLE_OAUTH_FAILURE_REDIRECT_URL=https://api.example.com/auth/oauth/failure

# === Mailer / SMTP Configuration ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
APP_URL=https://api.example.com
SMTP_KEY=your-smtp-key
BREVO_KEY=your-brevo-api-key

# === AI / LLM APIs ===
GEMINI_KEY=your-gemini-api-key
EMAIL_VERIFY_TOKEN_TTL_SECONDS=3600

OPENAI_API_KEY=sk-proj-your-openai-api-key

ANTHROPIC_BASE_URL=http://127.0.0.1:8787
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

CODEX_API_KEY=your-codex-api-key

# === Redis Cache Server ===
REDIS_SERVER_PASSWORD=your-redis-server-password

# === Translation Service ===
DEEPL_API_KEY=your-deepl-api-key

# === WebAuthn / Passkeys ===
WEBAUTHN_CEREMONY_SECRET=your-webauthn-ceremony-secret-hex-or-string
