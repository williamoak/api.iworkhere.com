# =============================================================================
# Example environment configuration. Copy to .env.development and fill in.
# Placeholder values only. NEVER put real secrets in this file.
# Loaded by src/helpers/config.ts in this order (later wins):
#   .env -> .env.local -> .env.{NODE_ENV} -> .env.{NODE_ENV}.local -> process.env
#
# Lines marked "derived" are computed in src/helpers/config.ts. They are shown
# commented out for reference only. ${APP_KEY} is NOT expanded by dotenv, so
# never uncomment them as written.
# =============================================================================

# === Application ===
HOST_IP=127.0.0.1
# Public API hostname only (no scheme, no path). Every API URL is derived from it.
APP_KEY=api.example.com
NODE_ENV=development
API_VERSION=v1

# --- derived (always computed from APP_KEY; values set here are overwritten) ---
# API_HOST=${APP_KEY}
# API_ORIGIN=https://${APP_KEY}
# API_BASE_URL=https://${APP_KEY}/api
# APP_URL=https://${APP_KEY}

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

MAX_CONCURRENT_REQUESTS=100

# === Auth tokens / seeding ===
SEED_BILL_PASSWORD=your-secure-seed-password
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RESET_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFY_TOKEN_TTL_SECONDS=3600

# === Debug ===
DEBUG=false
AUTH_ME_DEBUG=false
AUTH_MW_DEBUG=0
AUTH_OA_DEBUG=false

# === CockroachDB ===
DB_HOST=127.0.0.1
DB_PORT=26257
DB_NAME=api
DB_USER=api

# --- derived (default shown; set the variable to override) ---
# TLS servername / host for the DB connection. In Docker, set DB_HOSTNAME=cockroachdb.
# DB_HOSTNAME=${APP_KEY}
# Must contain ca.crt, client.<DB_USER>.crt and client.<DB_USER>.key.
# Relative paths resolve from the project root; absolute paths also work.
# DB_CERT_DIR=certs/cockroach

# === Google OAuth2 (all URLs must use https) ===
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_STATE_SECRET=your-oauth-state-secret
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# --- derived (default shown; set the variable to override) ---
# GOOGLE_OAUTH_REDIRECT_URI=https://${APP_KEY}/v1/auth/oauth/google/callback
# GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=https://${APP_KEY}/auth/oauth/success
# GOOGLE_OAUTH_FAILURE_REDIRECT_URL=https://${APP_KEY}/auth/oauth/failure

# Reference copy of the Google Cloud web client download (not read by the API).
GOOGLE_OAUTH_WEB_CLIENT_CREATION_DATE=Jan 1, 2026, 12:00:00 AM GMT
GOOGLE_OAUTH_WEB_JSON={"web":{"client_id":"your-google-oauth-client-id.apps.googleusercontent.com","project_id":"your-gcp-project-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"your-google-oauth-client-secret","redirect_uris":["https://api.example.com"],"javascript_origins":["https://api.example.com"]}}

# === Mailer / SMTP ===
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_KEY=your-smtp-key
BREVO_KEY=your-brevo-api-key

# === Redis cache (localhost) ===
REDIS_SERVER_PASSWORD=your-redis-server-password

# === DeepL translation ===
DEEPL_API_KEY=your-deepl-api-key

# === WebAuthn / passkeys ===
# Origins and RP IDs are resolved from enabled application_origins rows.
# Register each client origin against its applications.app_key instead of
# putting tenant domains in this API process environment.
WEBAUTHN_CEREMONY_SECRET=your-webauthn-ceremony-secret
